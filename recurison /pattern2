import java.util.*;
public class pattern2 {
    static void main(String[] args) {
        triangle(0,4);
    }
    static void triangle(int r, int c){
        if(c == 0){
            return;
        }
        if(c > r){
            triangle(r+1, c);
            System.out.print("*");

        }else{
            triangle(0, c-1);
            System.out.println();

        }
    }
}
